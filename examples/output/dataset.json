{
  "schema": [
    {
      "name": "sample_id",
      "description": "Unique sample identifier used consistently across all source documents",
      "type": "string",
      "required": true,
      "examples": [
        "S-01",
        "S-05"
      ]
    },
    {
      "name": "species",
      "description": "Organism studied",
      "type": "string",
      "required": true,
      "examples": [
        "Arabidopsis thaliana"
      ]
    },
    {
      "name": "treatment_mM_NaCl",
      "description": "Salinity treatment concentration, normalized to millimolar NaCl (0 = control)",
      "type": "number",
      "required": true,
      "examples": [
        0,
        50,
        100,
        150,
        200
      ]
    },
    {
      "name": "final_height_cm",
      "description": "Final measured plant height, normalized to centimeters",
      "type": "number",
      "required": true,
      "examples": [
        12.4,
        15.1
      ]
    },
    {
      "name": "germination_days",
      "description": "Days from planting to germination",
      "type": "number",
      "required": false,
      "examples": [
        3,
        4,
        9
      ]
    },
    {
      "name": "measurement_date",
      "description": "Date the measurement was recorded, normalized to ISO 8601",
      "type": "date",
      "required": false,
      "examples": [
        "2023-03-15"
      ]
    },
    {
      "name": "measured_by",
      "description": "Person who took/recorded the measurement",
      "type": "string",
      "required": false,
      "examples": [
        "K. Chen",
        "M. Diallo"
      ]
    },
    {
      "name": "source_batch",
      "description": "Which experimental batch the sample belongs to",
      "type": "categorical",
      "required": true,
      "examples": [
        "Batch A",
        "Batch B"
      ]
    },
    {
      "name": "notes",
      "description": "Free-text observations relevant to interpreting the record",
      "type": "string",
      "required": false,
      "examples": [
        "wilted by day 5, likely non-viable outlier"
      ]
    }
  ],
